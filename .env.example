# ============================================
# Configuración del proyecto TFM
# Copia este archivo a .env y rellena los valores.
# NO subir .env al repositorio (está en .gitignore).
# NO escribir credenciales reales en este archivo.
# ============================================

# -------- MongoDB --------
# Para uso local con docker-compose:
MONGO_USER=tfmuser
MONGO_PASSWORD=tfmpass
MONGO_DB=energia
MONGO_URI=mongodb://tfmuser:tfmpass@localhost:27017/

# Para MongoDB Atlas, comentar la línea de arriba y descomentar:
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/energia?authSource=admin&retryWrites=true&w=majority

# -------- Mongo Express UI --------
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=admin

# -------- APIs externas --------
# AEMET OpenData - obtener token gratuito en:
# https://opendata.aemet.es/centrodedatos/altaUsuario
AEMET_API_KEY=

# e·sios (REE) - solicitar token por mail a consultasios@ree.es
ESIOS_API_TOKEN=

# -------- Generación sintética --------
SYNTHETIC_START_DATE=2024-01-01
SYNTHETIC_END_DATE=2025-12-31
SYNTHETIC_SEED=42

# -------- Logging --------
LOG_LEVEL=INFO
